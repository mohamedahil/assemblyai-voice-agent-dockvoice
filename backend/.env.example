# Required: AssemblyAI API key (https://www.assemblyai.com/dashboard)
ASSEMBLYAI_API_KEY=

# Database. Defaults to a local SQLite file; use a Supabase/Postgres URL in production:
# postgresql+psycopg://user:password@host:5432/postgres
DATABASE_URL=sqlite:///./copilot.db

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173

# Optional: real vendor emails via Resend (https://resend.com). Without a key, emails are
# recorded in the outbox but not sent.
RESEND_API_KEY=
EMAIL_FROM=Warehouse Copilot <onboarding@resend.dev>
# Resend's free tier only delivers to your own address; all vendor mail is redirected here.
VENDOR_EMAIL_OVERRIDE=

# Voice agent voice (alba, eve, george, jane, jean, mary, michael, anna, charles, paul, vera)
AGENT_VOICE=michael
